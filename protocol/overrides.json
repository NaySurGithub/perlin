{
  "types": {
    "BlockCoordinates": ["container", [
      {"name": "x", "type": "zigzag32"},
      {"name": "y", "type": "varint"},
      {"name": "z", "type": "zigzag32"}
    ]],
    "BlockCoordinatesSigned": ["container", [
      {"name": "x", "type": "zigzag32"},
      {"name": "y", "type": "zigzag32"},
      {"name": "z", "type": "zigzag32"}
    ]],
    "CommandOrigin": ["container", [
      {"name": "type", "type": ["mapper", {"type": "varint", "mappings": {"0": "player", "3": "dev_console", "4": "test", "5": "automation_player"}}]},
      {"name": "uuid", "type": "uuid"},
      {"name": "request_id", "type": "string"},
      {"name": "player_id", "type": ["switch", {"compareTo": "type", "fields": {"dev_console": "zigzag64", "test": "zigzag64"}, "default": "void"}]}
    ]],
    "packet_command_request": ["container", [
      {"name": "command", "type": "string"},
      {"name": "origin", "type": "CommandOrigin"},
      {"name": "internal", "type": "bool"},
      {"name": "version", "type": "zigzag32"}
    ]],
    "packet_resource_pack_client_response": ["container", [
      {"name": "status", "type": ["mapper", {"type": "u8", "mappings": {"0": "none", "1": "refused", "2": "send_packs", "3": "have_all_packs", "4": "completed"}}]},
      {"name": "pack_ids", "type": ["array", {"countType": "lu16", "type": "string"}]}
    ]],
    "packet_move_player": ["container", [
      {"name": "runtime_id", "type": "varint64"},
      {"name": "position", "type": "vec3f"},
      {"name": "pitch", "type": "lf32"},
      {"name": "yaw", "type": "lf32"},
      {"name": "head_yaw", "type": "lf32"},
      {"name": "mode", "type": ["mapper", {"type": "u8", "mappings": {"0": "normal", "1": "reset", "2": "teleport", "3": "rotation"}}]},
      {"name": "on_ground", "type": "bool"},
      {"name": "ridden_runtime_id", "type": "varint64"},
      {"name": "teleport", "type": ["switch", {"compareTo": "mode", "fields": {"teleport": ["container", [
        {"name": "cause", "type": "zigzag32"},
        {"name": "source_entity_type", "type": "zigzag32"}
      ]]}, "default": "void"}]},
      {"name": "tick", "type": "varint64"}
    ]]
  },
  "retype": {
    "packet_network_chunk_publisher_update.coordinates": "BlockCoordinatesSigned",
    "packet_play_sound.coordinates": "BlockCoordinatesSigned"
  },
  "custom": {
    "level_chunk": "network/custom/LevelChunk.hpp",
    "subchunk": "network/custom/SubChunk.hpp",
    "subchunk_request": "network/custom/SubChunkRequest.hpp",
    "player_auth_input": "network/custom/PlayerAuthInput.hpp"
  }
}
